ADZUNA_APP_ID=
ADZUNA_APP_KEY=
APOLLO_API_KEY=
APIFY_API_TOKEN=
# APP_KEY is not something you fill in -- the app generates it itself on
# first run (see the Settings tab) so Claude Code/other LLMs can connect
# to this app's own /mcp endpoint. Leave it unset here.
PORT=8000
DB_PATH=./data/job_search.db
CV_UPLOAD_DIR=./data/uploads/cv
TAILORED_OUTPUT_DIR=./data/tailored
INHAND_DEDUCTION_PCT_LOW=0.20
INHAND_DEDUCTION_PCT_HIGH=0.30
